{
  "name": "er-diagram-viewer",
  "private": true,
  "version": "0.1.0",
  "type": "module",
  "description": "纯前端运行的智能 ER 图查看器：粘贴 SQL DDL 自动生成数据库关系图，支持外键智能推断、分片表合并与模块自动着色。Pure-frontend SQL DDL → interactive ER diagram with heuristic FK inference.",
  "keywords": [
    "er-diagram",
    "entity-relationship",
    "sql",
    "ddl",
    "database",
    "schema",
    "schema-visualization",
    "foreign-key",
    "fk-inference",
    "mysql",
    "postgresql",
    "sqlite",
    "cytoscape",
    "react",
    "typescript",
    "frontend-only",
    "single-file-html"
  ],
  "author": "lifefitting",
  "license": "MIT",
  "repo": "https://github.com/lifefitting/er-diagram-viewer",
  "packageManager": "bun@1.3.10",
  "engines": {
    "bun": ">=1.1.0"
  },
  "scripts": {
    "dev": "vite",
    "build": "tsc -b && vite build",
    "build:single": "tsc -b && vite build --mode singlefile && mv dist-single/index.html dist-single/er-diagram-viewer.html",
    "preview": "vite preview",
    "test": "vitest run",
    "test:watch": "vitest",
    "typecheck": "tsc -b --noEmit",
    "lint": "eslint \"src/**/*.{ts,tsx}\"",
    "lint:fix": "eslint --fix \"src/**/*.{ts,tsx}\"",
    "format": "prettier --write \"src/**/*.{ts,tsx,css,json}\"",
    "format:check": "prettier --check \"src/**/*.{ts,tsx,css,json}\""
  },
  "dependencies": {
    "cytoscape": "^3.30.2",
    "cytoscape-dagre": "^3.0.0",
    "cytoscape-fcose": "^2.2.0",
    "react": "^18.3.1",
    "react-dom": "^18.3.1",
    "zustand": "^4.5.5"
  },
  "devDependencies": {
    "@types/cytoscape": "^3.21.7",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@typescript-eslint/eslint-plugin": "^7.18.0",
    "@typescript-eslint/parser": "^7.18.0",
    "@vitejs/plugin-react": "^5.2.0",
    "autoprefixer": "^10.4.20",
    "clsx": "^2.1.1",
    "eslint": "^8.57.1",
    "eslint-config-prettier": "^9.1.0",
    "eslint-plugin-react": "^7.37.2",
    "eslint-plugin-react-hooks": "^4.6.2",
    "postcss": "^8.4.49",
    "prettier": "^3.3.3",
    "tailwindcss": "^3.4.15",
    "terser": "^5.48.0",
    "typescript": "^5.6.3",
    "vite": "^7.3.3",
    "vite-plugin-singlefile": "^2.3.3",
    "vitest": "^3.2.4"
  }
}